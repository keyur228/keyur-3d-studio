# ─────────────────────────────────────────────────────────────
#  Request-an-Asset form — email delivery
#  Copy this file to `.env` and fill in ONE provider.
#  Leave VITE_FORM_PROVIDER empty to use the built-in mailto fallback
#  (opens the visitor's email client pre-filled to assetcrate02@gmail.com).
# ─────────────────────────────────────────────────────────────

# web3forms | formspree | emailjs | (empty = mailto fallback)
VITE_FORM_PROVIDER=

# Web3Forms  → https://web3forms.com  (free access key, sent to your inbox)
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree  → https://formspree.io   (form id from https://formspree.io/f/<ID>)
VITE_FORMSPREE_FORM_ID=

# EmailJS    → https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
